{
  "name": "route-doctor-starter",
  "version": "0.1.0",
  "description": "A zero-dependency open-source CLI for web route, redirect, and indexability diagnostics",
  "type": "module",
  "private": true,
  "bin": {
    "routedoctor": "./bin/routedoctor.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scan": "node ./bin/routedoctor.js scan",
    "test": "node --test",
    "check": "node --check ./bin/routedoctor.js && node --check ./src/http.js && node --check ./src/scanner.js && node --test"
  },
  "keywords": ["seo", "nextjs", "redirects", "canonical", "technical-seo", "cli"],
  "license": "MIT"
}
